---
import '../styles/process.css';
---

<section class="process-section" id="process">
  <!-- Morphed wave border -->
  <svg class="process-border-wave-svg" viewBox="0 0 100 2000" preserveAspectRatio="none">
    <path class="process-border-path" d="M 50 0 Q 80 100, 50 200 T 50 400 T 50 600 T 50 800 T 50 1000 T 50 1200 T 50 1400 T 50 1600 T 50 1800 T 50 2000" fill="none" stroke="#37481A" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" opacity="0.3" />
  </svg>

  <div class="process-container">
    <h2 class="process-title split-words">Designing, building, and refining as one continuous process</h2>
    
    <div class="process-cards">
      <!-- Card 1 -->
      <div class="process-card card-1" data-index="1">
        <div class="card-header">
          <h3>01. Listen & define</h3>
        </div>
        <div class="card-body">
          <div class="card-image-wrapper">
            <img src="/assets/process/listen.jpg" alt="Listen and define" loading="lazy" />
          </div>
          <p class="card-subheading">Understanding your business, users, and real goals.</p>
        </div>
      </div>
      
      <!-- Card 2 -->
      <div class="process-card card-2" data-index="2">
        <div class="card-header">
          <h3>02. Strategy & plan</h3>
        </div>
        <div class="card-body">
          <div class="card-image-wrapper">
            <img src="/assets/process/strategy.jpg" alt="Strategy and plan" loading="lazy" />
          </div>
          <p class="card-subheading">Turning insight into structure, flows, and priorities.</p>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="process-card card-3" data-index="3">
        <div class="card-header">
          <h3>03. Design & refine</h3>
        </div>
        <div class="card-body">
          <div class="card-image-wrapper">
            <img src="/assets/process/design.jpg" alt="Design and refine" loading="lazy" />
          </div>
          <p class="card-subheading">Visual language, UX, and iteration.</p>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="process-card card-4" data-index="4">
        <div class="card-header">
          <h3>04. Build & test</h3>
        </div>
        <div class="card-body">
          <div class="card-image-wrapper">
            <img src="/assets/process/build.jpg" alt="Build and test" loading="lazy" />
          </div>
          <p class="card-subheading">WordPress, motion, & deployment.</p>
        </div>
      </div>
    </div>

    <!-- Horizontal animated capsules track at the bottom of the section -->
    <div class="section-capsules-section">
      <div class="capsules-track-wrapper">
        <div class="capsules-track">
          <!-- Item 1 -->
          <div class="capsule-item">
            <img src="/assets/capsules/brand-guidelines.jpg" alt="Brand Guidelines" loading="lazy" />
            <div class="capsule-overlay">
              <span class="capsule-badge">01</span>
              <span class="capsule-text">Brand Guidelines</span>
            </div>
          </div>
          <!-- Item 2 -->
          <div class="capsule-item">
            <img src="/assets/capsules/motion-graphics.jpg" alt="Motion Graphics" loading="lazy" />
            <div class="capsule-overlay">
              <span class="capsule-badge">02</span>
              <span class="capsule-text">Motion Graphics</span>
            </div>
          </div>
          <!-- Item 3 -->
          <div class="capsule-item">
            <img src="/assets/capsules/packaging-design.jpg" alt="Tactile Packaging" loading="lazy" />
            <div class="capsule-overlay">
              <span class="capsule-badge">03</span>
              <span class="capsule-text">Tactile Packaging</span>
            </div>
          </div>
          <!-- Item 4 -->
          <div class="capsule-item">
            <img src="/assets/capsules/editorial-poster.jpg" alt="Editorial Posters" loading="lazy" />
            <div class="capsule-overlay">
              <span class="capsule-badge">04</span>
              <span class="capsule-text">Editorial Posters</span>
            </div>
          </div>
          <!-- Item 5 -->
          <div class="capsule-item">
            <img src="/assets/capsules/design-system.jpg" alt="Design Systems" loading="lazy" />
            <div class="capsule-overlay">
              <span class="capsule-badge">05</span>
              <span class="capsule-text">Design Systems</span>
            </div>
          </div>
          <!-- Item 6 -->
          <div class="capsule-item">
            <img src="/assets/capsules/interactive-web.jpg" alt="Interactive Web" loading="lazy" />
            <div class="capsule-overlay">
              <span class="capsule-badge">06</span>
              <span class="capsule-text">Interactive Web</span>
            </div>
          </div>
          <!-- Item 7 -->
          <div class="capsule-item">
            <img src="/assets/capsules/mobile-prototype.jpg" alt="Mobile Prototyping" loading="lazy" />
            <div class="capsule-overlay">
              <span class="capsule-badge">07</span>
              <span class="capsule-text">Mobile Prototyping</span>
            </div>
          </div>
          <!-- Item 8 -->
          <div class="capsule-item">
            <img src="/assets/capsules/art-direction.jpg" alt="Art Direction" loading="lazy" />
            <div class="capsule-overlay">
              <span class="capsule-badge">08</span>
              <span class="capsule-text">Art Direction</span>
            </div>
          </div>

          <!-- Duplicate for seamless infinite loop -->
          <div class="capsule-item" aria-hidden="true">
            <img src="/assets/capsules/brand-guidelines.jpg" alt="" loading="lazy" />
            <div class="capsule-overlay">
              <span class="capsule-badge">01</span>
              <span class="capsule-text">Brand Guidelines</span>
            </div>
          </div>
          <div class="capsule-item" aria-hidden="true">
            <img src="/assets/capsules/motion-graphics.jpg" alt="" loading="lazy" />
            <div class="capsule-overlay">
              <span class="capsule-badge">02</span>
              <span class="capsule-text">Motion Graphics</span>
            </div>
          </div>
          <div class="capsule-item" aria-hidden="true">
            <img src="/assets/capsules/packaging-design.jpg" alt="" loading="lazy" />
            <div class="capsule-overlay">
              <span class="capsule-badge">03</span>
              <span class="capsule-text">Tactile Packaging</span>
            </div>
          </div>
          <div class="capsule-item" aria-hidden="true">
            <img src="/assets/capsules/editorial-poster.jpg" alt="" loading="lazy" />
            <div class="capsule-overlay">
              <span class="capsule-badge">04</span>
              <span class="capsule-text">Editorial Posters</span>
            </div>
          </div>
          <div class="capsule-item" aria-hidden="true">
            <img src="/assets/capsules/design-system.jpg" alt="" loading="lazy" />
            <div class="capsule-overlay">
              <span class="capsule-badge">05</span>
              <span class="capsule-text">Design Systems</span>
            </div>
          </div>
          <div class="capsule-item" aria-hidden="true">
            <img src="/assets/capsules/interactive-web.jpg" alt="" loading="lazy" />
            <div class="capsule-overlay">
              <span class="capsule-badge">06</span>
              <span class="capsule-text">Interactive Web</span>
            </div>
          </div>
          <div class="capsule-item" aria-hidden="true">
            <img src="/assets/capsules/mobile-prototype.jpg" alt="" loading="lazy" />
            <div class="capsule-overlay">
              <span class="capsule-badge">07</span>
              <span class="capsule-text">Mobile Prototyping</span>
            </div>
          </div>
          <div class="capsule-item" aria-hidden="true">
            <img src="/assets/capsules/art-direction.jpg" alt="" loading="lazy" />
            <div class="capsule-overlay">
              <span class="capsule-badge">08</span>
              <span class="capsule-text">Art Direction</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initProcessAnimations() {
    // Reveal Title
    const title = document.querySelector('.process-title');
    if (title) {
      gsap.fromTo(title, 
        { opacity: 0, y: 50 }, 
        { 
          opacity: 1, 
          y: 0, 
          duration: 1, 
          ease: "power3.out",
          scrollTrigger: {
            trigger: title,
            start: "top 80%",
          }
        }
      );
    }

    // Stacking Cards Logic (Desktop Card Deck Effect)
    const isDesktop = window.matchMedia('(min-width: 769px)').matches;
    if (isDesktop) {
      const cards = document.querySelectorAll('.process-card');
      
      cards.forEach((card, i) => {
        if (i < cards.length - 1) {
          const nextCard = cards[i + 1];
          const stickyTop = 90 + (i + 1) * 65; // 155px, 220px, 285px
          
          ScrollTrigger.create({
            trigger: nextCard,
            start: 'top 85%',
            end: `top ${stickyTop}px`,
            scrub: true,
            onUpdate: (self) => {
              const progress = self.progress;
              // Slightly scale down and enhance depth shadow for stacked card behind
              gsap.set(card, {
                scale: 1 - progress * 0.05,
                filter: `brightness(${1 - progress * 0.08})`,
                transformOrigin: 'top center',
              });
            }
          });
        }
      });
    }

    // Animate the border wave line entering this section
    const borderWave = document.querySelector('.process-border-path');
    if (borderWave) {
      const length = (borderWave as SVGPathElement).getTotalLength() || 2000;
      gsap.set(borderWave, { strokeDasharray: length, strokeDashoffset: length });

      gsap.to(borderWave,
        {
          strokeDashoffset: 0,
          ease: "none",
          scrollTrigger: {
            trigger: ".process-section",
            start: "top center",
            end: "bottom bottom",
            scrub: 1
          }
        }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProcessAnimations);
  } else {
    initProcessAnimations();
  }
  document.addEventListener('astro:page-load', initProcessAnimations);
</script>
