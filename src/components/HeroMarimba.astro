---
/**
 * HeroMarimba — "marimba. designs" Hero Section
 * Warm editorial hero with aurora gradients, decorative shapes,
 * inline pill images, and vertical nav.
 */
---

<!-- ─── Grid Hairlines (Decorative) ──────────────────────── -->
<div class="hero-gridlines" aria-hidden="true"></div>

<!-- ─── Hero Section ─────────────────────────────────────── -->
<section class="hero-section" id="hero" aria-label="Hero">

  <!-- Header row -->
  <header class="hero-header">
    <!-- Logo -->
    <a href="/" class="hero-logo" aria-label="Sadia Aqeel — Home">
      Sadia<span class="hero-logo__line2">Aqeel</span>
    </a>

    <!-- Meta info (desktop only) -->
    <div class="hero-meta">
      <span class="hero-meta__item" style="left: calc(41.935 * 1vw);">Graphic designer</span>
      <span class="hero-meta__item" style="left: calc(61.237 * 1vw);">Available worldwide</span>
    </div>
  </header>

  <!-- Decorative layer (behind text) -->
  <div class="hero-decorative" aria-hidden="true">

    <!-- Aurora blob -->
    <div class="hero-blob"></div>

    <!-- Noise overlay -->
    <div class="hero-noise"></div>

    <!-- Ghost UI streaks -->
    <div class="hero-ghost"></div>

    <!-- Shape: Flower/asterisk blob (6-lobe scallop) -->
    <div class="hero-shape-flower">
      <svg viewBox="0 0 90 90" fill="none" xmlns="http://www.w3.org/2000/svg" width="90" height="90">
        <defs>
          <linearGradient id="grad-flower" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#F3EBC0"/>
            <stop offset="100%" stop-color="#92D68A"/>
          </linearGradient>
        </defs>
        <path d="M45 5 C55 5, 55 20, 50 28 C60 18, 75 15, 78 25 C81 35, 68 40, 58 40 C70 42, 80 52, 75 62 C70 72, 58 68, 50 60 C55 72, 50 85, 40 85 C30 85, 28 72, 32 60 C24 70, 12 72, 8 62 C4 52, 15 45, 28 42 C16 40, 8 30, 12 20 C16 10, 30 15, 38 25 C34 15, 35 5, 45 5Z"
              fill="url(#grad-flower)" opacity="0.85"/>
      </svg>
    </div>

    <!-- Shape: 8-point starburst -->
    <div class="hero-shape-starburst">
      <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" width="200" height="200">
        <defs>
          <linearGradient id="grad-starburst" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#9FD3F0"/>
            <stop offset="50%" stop-color="#D5B8E0"/>
            <stop offset="100%" stop-color="#A8E6C8"/>
          </linearGradient>
        </defs>
        <path d="M100 10 L108 75 L150 20 L115 80 L185 55 L120 92 L190 100 L120 108 L185 145 L115 120 L150 180 L108 125 L100 190 L92 125 L50 180 L85 120 L15 145 L80 108 L10 100 L80 92 L15 55 L85 80 L50 20 L92 75 Z"
              fill="url(#grad-starburst)" opacity="0.7"/>
      </svg>
    </div>

    <!-- Shape: Leaf (solid green half-circle bleeding off right) -->
    <div class="hero-shape-leaf">
      <svg viewBox="0 0 130 255" fill="none" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
        <ellipse cx="130" cy="127.5" rx="130" ry="127.5" fill="#92D68A" opacity="0.9"/>
      </svg>
    </div>

    <!-- Shape: Pinwheel (4 overlapping petals) -->
    <div class="hero-shape-pinwheel">
      <svg viewBox="0 0 220 220" fill="none" xmlns="http://www.w3.org/2000/svg" width="220" height="220">
        <!-- Top petal - pale yellow -->
        <ellipse cx="110" cy="70" rx="35" ry="65" fill="#F3EBC0" opacity="0.6" transform="rotate(0 110 110)"/>
        <!-- Right petal - lavender -->
        <ellipse cx="150" cy="110" rx="35" ry="65" fill="#D5B8E0" opacity="0.6" transform="rotate(90 110 110)"/>
        <!-- Bottom petal - blue -->
        <ellipse cx="110" cy="150" rx="35" ry="65" fill="#B5DDF0" opacity="0.6" transform="rotate(0 110 110)"/>
        <!-- Left petal - green -->
        <ellipse cx="70" cy="110" rx="35" ry="65" fill="#A8E6C8" opacity="0.6" transform="rotate(90 110 110)"/>
      </svg>
    </div>
  </div>

  <!-- Hero center content -->
  <div class="hero-center">
    <!-- Badge -->
    <span class="hero-badge">Graphic design & branding</span>

    <!-- Headline -->
    <h1 class="hero-title">
      I <a class="pill-link" href="/about" aria-label="About me"><img
        class="pill-img"
        src="/assets/hero/portrait.jpg"
        alt="Portrait of the designer, smiling with glasses"
        width="125"
        height="88"
        loading="eager"
        decoding="async"
      ><span class="pill-link__veil" aria-hidden="true"></span><span class="pill-link__label" aria-hidden="true">About me</span></a> craft bold, expressive<br class="desktop-br">
      visuals for brands <a class="pill-link" href="/work" aria-label="Work"><img
        class="pill-img pill-img--lilac"
        src="/assets/hero/branding-mockup.jpg"
        alt="Poster and business card branding mockup on a wooden desk"
        width="125"
        height="88"
        loading="eager"
        decoding="async"
      ><span class="pill-link__veil" aria-hidden="true"></span><span class="pill-link__label" aria-hidden="true">Work</span></a> that want<br class="desktop-br">
      to be felt, not just seen.
    </h1>
  </div>

  <div class="cursor-dot" aria-hidden="true"></div>

</section>

<script>
  // ─── Interactive Pill Cursor ──────────────────────────────
  const dot = document.querySelector('.cursor-dot') as HTMLElement;
  const pills = document.querySelectorAll('.pill-link');
  let x = 0, y = 0, tx = 0, ty = 0;

  if (dot && pills.length > 0) {
    window.addEventListener('pointermove', e => {
      tx = e.clientX;
      ty = e.clientY;
    });

    pills.forEach(p => {
      p.addEventListener('pointerenter', () => {
        dot.classList.add('is-on');
      });
      p.addEventListener('pointerleave', () => {
        dot.classList.remove('is-on');
      });
    });

    (function loop(){
      x += (tx - x) * 0.2;
      y += (ty - y) * 0.2;
      dot.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
      requestAnimationFrame(loop);
    })();
  }
</script>
