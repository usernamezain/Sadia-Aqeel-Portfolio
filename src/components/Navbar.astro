---
/**
 * Navbar Component
 * Glassmorphic fixed navigation with smooth scroll & mobile menu.
 */
import { navItems, siteConfig } from '../data/portfolio';
---

<nav class="navbar" id="navbar" aria-label="Main navigation">
  <div class="navbar__inner container">
    <!-- Logo -->
    <a href="/" class="navbar__logo magnetic" aria-label={`${siteConfig.name} — Home`}>
      <span class="navbar__logo-text">SA</span>
      <span class="navbar__logo-dot"></span>
    </a>

    <!-- Desktop Nav -->
    <ul class="navbar__links" role="list">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class="navbar__link magnetic" data-navlink>
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA Button -->
    <a href="/contact" class="btn btn-primary navbar__cta magnetic">
      Let's Talk
    </a>

    <!-- Mobile Menu Toggle -->
    <button
      class="navbar__toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle menu"
    >
      <span class="navbar__toggle-line"></span>
      <span class="navbar__toggle-line"></span>
      <span class="navbar__toggle-line"></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div class="navbar__mobile" id="mobile-menu" aria-hidden="true">
    <ul class="navbar__mobile-links" role="list">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class="navbar__mobile-link">{item.label}</a>
        </li>
      ))}
    </ul>
    <a href="/contact" class="btn btn-primary navbar__mobile-cta">
      Let's Talk
    </a>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: var(--z-nav);
    padding: var(--space-4) 0;
    transition: all 0.4s var(--ease-out-expo);
  }

  .navbar.is-scrolled {
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding: var(--space-3) 0;
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Logo */
  .navbar__logo {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-white);
    z-index: 10;
  }

  .navbar__logo-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    display: inline-block;
  }

  /* Desktop links */
  .navbar__links {
    display: flex;
    gap: var(--space-8);
  }

  .navbar__link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-gray-400);
    transition: color var(--transition-fast);
    position: relative;
  }

  .navbar__link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-accent);
    transition: width 0.3s var(--ease-out-expo);
  }

  .navbar__link:hover,
  .navbar__link.is-active {
    color: var(--color-white);
  }

  .navbar__link:hover::after,
  .navbar__link.is-active::after {
    width: 100%;
  }

  /* CTA */
  .navbar__cta {
    padding: var(--space-2) var(--space-6);
    font-size: var(--text-xs);
  }

  /* Mobile toggle */
  .navbar__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    z-index: 10;
    padding: var(--space-2);
  }

  .navbar__toggle-line {
    width: 24px;
    height: 2px;
    background: var(--color-white);
    border-radius: 2px;
    transition: all 0.3s var(--ease-out-expo);
    transform-origin: center;
  }

  .navbar__toggle.is-active .navbar__toggle-line:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .navbar__toggle.is-active .navbar__toggle-line:nth-child(2) {
    opacity: 0;
  }

  .navbar__toggle.is-active .navbar__toggle-line:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Mobile menu */
  .navbar__mobile {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: rgba(10, 10, 10, 0.97);
    backdrop-filter: blur(30px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    opacity: 0;
    visibility: hidden;
    transition: all 0.5s var(--ease-out-expo);
    z-index: 5;
  }

  .navbar__mobile.is-open {
    opacity: 1;
    visibility: visible;
  }

  .navbar__mobile-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .navbar__mobile-link {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-white);
    transition: color var(--transition-fast);
  }

  .navbar__mobile-link:hover {
    color: var(--color-accent);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .navbar {
      padding: var(--space-3) 0;
    }

    .navbar__links,
    .navbar__cta {
      display: none;
    }

    .navbar__toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
      cursor: pointer;
    }

    .navbar__mobile {
      height: 100dvh;
      padding: 80px 24px 40px;
      justify-content: space-between;
      overflow-y: auto;
    }

    .navbar__mobile-link {
      font-size: clamp(1.5rem, 6vw, 2.25rem);
    }

    .navbar__mobile-cta {
      width: 100%;
      max-width: 280px;
      text-align: center;
      padding: 14px 24px;
      font-size: var(--text-sm);
    }
  }
</style>

<script>
  // Scroll behavior
  const navbar = document.getElementById('navbar');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('is-scrolled');
    } else {
      navbar?.classList.remove('is-scrolled');
    }
  });

  // Active link highlight
  const currentPath = window.location.pathname;
  document.querySelectorAll('[data-navlink]').forEach((link) => {
    if ((link as HTMLAnchorElement).getAttribute('href') === currentPath) {
      link.classList.add('is-active');
    }
  });

  // Mobile menu toggle
  const toggle = document.getElementById('nav-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.classList.toggle('is-active');
    mobileMenu?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(isOpen));
    mobileMenu?.setAttribute('aria-hidden', String(!isOpen));
    document.body.style.overflow = isOpen ? 'hidden' : '';
  });

  // Close mobile menu on link click
  document.querySelectorAll('.navbar__mobile-link').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.classList.remove('is-active');
      mobileMenu?.classList.remove('is-open');
      document.body.style.overflow = '';
    });
  });
</script>
