---
/**
 * ServicesHoverBend.astro — Sadia Aqeel Portfolio
 * High-end editorial interactive services showcase with WebGL inertial hover bend & chromatic aberration.
 * Faithful implementation of hover-image-bend.html styled to the portfolio's warm cream & deep olive design language.
 */

export interface ServiceItem {
  num: string;
  title: string;
  desc: string;
  image: string;
  imageAlt: string;
  tag?: string;
  weeks?: string;
  deliverables: string[];
  icon?: string;
}

interface Props {
  services: ServiceItem[];
}

const { services } = Astro.props;
---

<section class="services-bend-section" id="services-showcase" aria-label="Services Showcase">
  
  <!-- Subtle Editorial Subheader -->
  <div class="services-bend-header">
    <div class="services-bend-header__left">
      <span class="services-bend-badge">Core Capabilities</span>
      <span class="services-bend-count">0{services.length} Design Disciplines</span>
    </div>
    <div class="services-bend-header__right">
      <span class="services-bend-hint">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        Hover row to reveal dynamic mockup · Click to book inquiry
      </span>
    </div>
  </div>

  <!-- Interactive Row List -->
  <ul class="services-bend-list" id="services-bend-list" role="list">
    {services.map((service, index) => (
      <li class="services-bend-item">
        <a 
          href={`/contact?service=${encodeURIComponent(service.title)}`}
          class="services-bend-row"
          data-img={service.image}
          data-index={index}
          data-title={service.title}
          aria-label={`${service.title} — ${service.desc}`}
        >
          <!-- Column 1: Index Number + Service Title -->
          <div class="row-title-col">
            <span class="row-num">{service.num}</span>
            <h2 class="row-name">{service.title}</h2>
          </div>

          <!-- Column 2: Editorial Description (Clean Pure Text) -->
          <div class="row-desc-col">
            <p class="row-desc">{service.desc}</p>
          </div>

          <!-- Column 3: Category / Timeline & Action Icon (Pure Text, No Capsules) -->
          <div class="row-meta-col">
            <div class="row-badges">
              <span class="row-tag">{service.tag || service.deliverables[0]}</span>
              <span class="row-time">{service.weeks || '2-3 Weeks'}</span>
            </div>
            <div class="row-arrow-circle" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </div>
          </div>

          <!-- Mobile Inline Preview (Touch devices & responsive mobile viewports) -->
          <div class="row-mobile-thumb" aria-hidden="true">
            <img src={service.image} alt={service.imageAlt} loading="lazy" />
          </div>
        </a>
      </li>
    ))}
  </ul>

  <!-- WebGL Canvas for 3D Bending Image Effect -->
  <canvas id="gl-services-bend" class="gl-services-canvas" aria-hidden="true"></canvas>
</section>

<style>
  /* ─── Section Shell ──────────────────────────────────────── */
  .services-bend-section {
    position: relative;
    width: 100%;
    margin-bottom: clamp(4rem, 8vw, 8rem);
  }

  /* ─── Editorial Subheader ────────────────────────────────── */
  .services-bend-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(55, 72, 26, 0.18);
    margin-bottom: 0.5rem;
  }

  .services-bend-header__left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .services-bend-badge {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: #37481A;
    background: rgba(55, 72, 26, 0.08);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid rgba(55, 72, 26, 0.14);
  }

  .services-bend-count {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    color: rgba(55, 72, 26, 0.6);
  }

  .services-bend-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    color: rgba(55, 72, 26, 0.65);
  }

  /* ─── Interactive List ───────────────────────────────────── */
  .services-bend-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .services-bend-item {
    border-bottom: 1px solid rgba(55, 72, 26, 0.14);
  }

  .services-bend-row {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1.15fr) minmax(0, 0.55fr);
    gap: 1.5rem 2.5rem;
    align-items: center;
    padding-block: clamp(1.6rem, 2.7vw, 2.5rem);
    color: inherit;
    text-decoration: none;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  /* ─── Col 1: Title & Index ───────────────────────────────── */
  .row-title-col {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
  }

  .row-num {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    font-weight: 800;
    color: rgba(55, 72, 26, 0.35);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), color 0.3s ease;
    flex-shrink: 0;
  }

  .row-name {
    margin: 0;
    font-family: 'Fraunces', 'Clash Display', Georgia, serif;
    font-size: clamp(1.75rem, 3.1vw, 2.9rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: #37481A;
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1), color 0.3s ease;
  }

  /* ─── Col 2: Editorial Description (Clean, No Capsules) ─── */
  .row-desc-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .row-desc {
    margin: 0;
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: clamp(0.92rem, 1.05vw, 1.02rem);
    line-height: 1.6;
    color: rgba(55, 72, 26, 0.75);
    max-width: 48ch;
  }

  /* ─── Col 3: Meta & Action (Pure Text, No Borders/Bg) ───── */
  .row-meta-col {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.5rem;
  }

  .row-badges {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
  }

  /* Pure text category: no borders, no background, no capsule shape */
  .row-tag {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: clamp(0.86rem, 1vw, 0.96rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #37481A;
    background: none;
    border: none;
    padding: 0;
    border-radius: 0;
    white-space: nowrap;
    transition: color 0.3s ease;
  }

  .row-time {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    color: rgba(55, 72, 26, 0.55);
    white-space: nowrap;
  }

  .row-arrow-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(55, 72, 26, 0.2);
    background: rgba(255, 255, 255, 0.85);
    color: #37481A;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
    flex-shrink: 0;
  }

  /* ─── Hover States (Fine Pointer) ────────────────────────── */
  @media (hover: hover) and (pointer: fine) {
    .services-bend-list:hover .services-bend-row {
      opacity: 0.35;
    }

    .services-bend-list .services-bend-row:hover {
      opacity: 1;
    }

    .services-bend-row:hover .row-name {
      transform: translateX(1.35rem);
      color: #759D42;
    }

    .services-bend-row:hover .row-num {
      color: #759D42;
      transform: translateX(0.35rem);
    }

    .services-bend-row:hover .row-tag {
      color: #759D42;
    }

    .services-bend-row:hover .row-arrow-circle {
      background: #37481A;
      color: #F0EFEA;
      border-color: #37481A;
      transform: rotate(45deg) scale(1.08);
    }
  }

  /* ─── Responsive Layout Across All Aspect Ratios ─────────── */
  .row-mobile-thumb {
    display: none;
  }

  /* Tablet / Medium Breakpoint (641px – 900px) */
  @media (max-width: 900px) and (min-width: 641px) {
    .services-bend-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }

    .services-bend-hint {
      display: none;
    }

    .services-bend-row {
      grid-template-columns: 1fr auto;
      gap: 1rem 1.5rem;
      padding-block: 1.6rem;
    }

    .row-title-col {
      grid-column: 1 / 2;
    }

    .row-meta-col {
      grid-column: 2 / 3;
      justify-content: flex-end;
    }

    .row-desc-col {
      grid-column: 1 / 3;
    }

    .row-badges {
      align-items: flex-end;
      gap: 0.2rem;
    }

    .row-mobile-thumb {
      display: block;
      grid-column: 1 / 3;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid rgba(55, 72, 26, 0.1);
      margin-top: 0.5rem;
      background: #E8E6DF;
    }

    .row-mobile-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  }

  /* Large Touch Screens / Tablets without fine pointer */
  @media (hover: none) and (min-width: 901px) {
    .services-bend-hint {
      display: none;
    }

    .services-bend-row {
      grid-template-columns: 1fr auto;
      gap: 1rem 2rem;
      padding-block: 1.75rem;
    }

    .row-title-col {
      grid-column: 1 / 2;
    }

    .row-meta-col {
      grid-column: 2 / 3;
      justify-content: flex-end;
    }

    .row-desc-col {
      grid-column: 1 / 3;
    }

    .row-mobile-thumb {
      display: block;
      grid-column: 1 / 3;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid rgba(55, 72, 26, 0.1);
      margin-top: 0.5rem;
      background: #E8E6DF;
    }

    .row-mobile-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  }

  /* Mobile Portrait & Small Viewports (<= 640px down to 320px) */
  @media (max-width: 640px) {
    .services-bend-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
      padding-bottom: 1rem;
    }

    .services-bend-header__left {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .services-bend-hint {
      display: none;
    }

    .services-bend-row {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      padding-block: 1.35rem;
    }

    .row-title-col {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      width: 100%;
    }

    .row-num {
      font-size: 1.15rem;
    }

    .row-name {
      font-size: clamp(1.4rem, 6vw, 1.85rem);
      line-height: 1.15;
      word-break: break-word;
    }

    .row-desc-col {
      width: 100%;
    }

    .row-desc {
      font-size: clamp(0.88rem, 3.6vw, 0.98rem);
      line-height: 1.5;
      max-width: 100%;
      color: rgba(55, 72, 26, 0.78);
    }

    .row-meta-col {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      margin-top: 0.2rem;
    }

    .row-badges {
      align-items: baseline;
      flex-direction: row;
      gap: 0.65rem;
    }

    .row-tag {
      font-size: 0.88rem;
    }

    .row-time {
      font-size: 0.76rem;
      margin-top: 0;
    }

    .row-arrow-circle {
      width: 38px;
      height: 38px;
    }

    .row-mobile-thumb {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid rgba(55, 72, 26, 0.1);
      margin-top: 0.35rem;
      background: #E8E6DF;
    }

    .row-mobile-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  }

  /* ─── WebGL Canvas ───────────────────────────────────────── */
  .gl-services-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 999;
    visibility: hidden;
  }
</style>

<script>
  import * as THREE from 'three';

  let cleanupFn: (() => void) | null = null;

  function initServicesHoverBend() {
    if (cleanupFn) {
      cleanupFn();
      cleanupFn = null;
    }

    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const list = document.getElementById('services-bend-list');
    let canvas = document.getElementById('gl-services-bend') as HTMLCanvasElement | null;

    if (!fine || reduce || !list || !canvas) return;

    // Teleport canvas to document.body so it is never trapped inside overflow/transforms
    if (canvas.parentElement !== document.body) {
      document.body.appendChild(canvas);
    }

    const rows = Array.from(list.querySelectorAll<HTMLAnchorElement>('.services-bend-row'));
    if (!rows.length) return;

    // ─── Setup Three.js WebGL Scene ─────────────────────────
    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: 'high-performance',
      });
    } catch (e) {
      return;
    }

    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.setClearColor(0x000000, 0);

    let W = window.innerWidth;
    let H = window.innerHeight;
    renderer.setSize(W, H, false);

    const scene = new THREE.Scene();
    const cam = new THREE.OrthographicCamera(-W / 2, W / 2, H / 2, -H / 2, -1000, 1000);

    // Aspect ratio 1200x896 (approx 1.34:1)
    let PW = Math.min(420, W * 0.32);
    let PH = Math.round(PW * (896 / 1200));

    // ─── Fallback Canvas Texture Generator (Portfolio Warm Brand Colors) ─
    function makeBrandFallbackTexture(index: number, title: string): THREE.Texture {
      const cv = document.createElement('canvas');
      cv.width = 600;
      cv.height = 448;
      const ctx = cv.getContext('2d');
      if (!ctx) return new THREE.Texture();

      // Palette using real portfolio brand identity
      const BRAND_PALETTES = [
        ['#37481A', '#759D42'],
        ['#283513', '#92D68A'],
        ['#37481A', '#EBCB8B'],
        ['#1F2B0E', '#759D42'],
        ['#37481A', '#B5DDF0'],
        ['#243111', '#92D68A'],
      ];
      const p = BRAND_PALETTES[index % BRAND_PALETTES.length];

      // Subtle editorial gradient
      const grad = ctx.createLinearGradient(0, 0, 600, 448);
      grad.addColorStop(0, p[0]);
      grad.addColorStop(0.65, '#222E10');
      grad.addColorStop(1, '#151D0A');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, 600, 448);

      // Geometric grid lines & soft cards
      ctx.strokeStyle = 'rgba(240, 239, 234, 0.12)';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(30, 30, 540, 388);

      // Accent pill
      ctx.fillStyle = p[1];
      ctx.beginPath();
      ctx.roundRect(40, 40, 120, 26, 13);
      ctx.fill();

      ctx.fillStyle = '#151D0A';
      ctx.font = '600 12px "Instrument Sans", sans-serif';
      ctx.fillText('CORE SERVICE', 54, 57);

      // Service title
      ctx.fillStyle = '#F0EFEA';
      ctx.font = '800 32px "Fraunces", Georgia, serif';
      ctx.fillText(title, 40, 370);

      // Decorative dot pattern
      ctx.fillStyle = 'rgba(240, 239, 234, 0.2)';
      for (let x = 0; x < 6; x++) {
        for (let y = 0; y < 4; y++) {
          ctx.beginPath();
          ctx.arc(420 + x * 22, 60 + y * 22, 3, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      const tex = new THREE.CanvasTexture(cv);
      tex.minFilter = THREE.LinearFilter;
      tex.magFilter = THREE.LinearFilter;
      return tex;
    }

    // ─── Preload Textures ─────────────────────────────────────
    const textureLoader = new THREE.TextureLoader();
    const textures: THREE.Texture[] = rows.map((row, i) => {
      const title = row.getAttribute('data-title') || `Service 0${i + 1}`;
      const url = row.getAttribute('data-img');
      const fallback = makeBrandFallbackTexture(i, title);

      if (url) {
        textureLoader.load(
          url,
          (loadedTex) => {
            loadedTex.minFilter = THREE.LinearFilter;
            loadedTex.magFilter = THREE.LinearFilter;
            loadedTex.generateMipmaps = false;
            textures[i] = loadedTex;
            if (activeHoverIndex === i && mat) {
              mat.uniforms.uTex.value = loadedTex;
            }
          },
          undefined,
          () => {
            // keep fallback on error
          }
        );
      }

      return fallback;
    });

    // ─── Custom Shader Material with Bending & RGB Split ─────
    const mat = new THREE.ShaderMaterial({
      transparent: true,
      uniforms: {
        uTex: { value: textures[0] },
        uVel: { value: new THREE.Vector2() },
        uOp: { value: 0 },
      },
      vertexShader: `
        uniform vec2 uVel;
        varying vec2 vUv;
        void main() {
          vUv = uv;
          vec3 p = position;
          // Sine wave bend following mouse velocity
          p.x += uVel.x * sin(uv.y * 3.14159265) * 0.22;
          p.y += uVel.y * sin(uv.x * 3.14159265) * 0.22;
          // Dynamic skew
          p.x += uVel.x * (uv.y - 0.5) * 0.18;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(p, 1.0);
        }
      `,
      fragmentShader: `
        uniform sampler2D uTex;
        uniform vec2 uVel;
        uniform float uOp;
        varying vec2 vUv;

        // Rounded box signed distance field
        float rbox(vec2 p, vec2 b, float r) {
          vec2 q = abs(p) - b + r;
          return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
        }

        void main() {
          // Chromatic aberration follows velocity magnitude
          vec2 off = uVel * 0.016;
          float r = texture2D(uTex, vUv + off).r;
          float g = texture2D(uTex, vUv).g;
          float b = texture2D(uTex, vUv - off).b;

          // Smooth antialiased rounded corners (radius 0.05)
          float d = rbox(vUv - 0.5, vec2(0.5), 0.05);
          float a = smoothstep(0.0, -0.012, d);

          gl_FragColor = vec4(vec3(r, g, b), a * uOp);
        }
      `,
    });

    const mesh = new THREE.Mesh(new THREE.PlaneGeometry(1, 1, 32, 32), mat);
    mesh.scale.set(PW, PH, 1);
    scene.add(mesh);

    // ─── Interaction & Physics Coordinates ────────────────────
    const cur = { x: W / 2, y: H / 2 };
    const tgt = { x: W / 2, y: H / 2 };
    const vel = new THREE.Vector2();
    let shown = false;
    let op = 0;
    let sc = 1;
    let activeHoverIndex = 0;
    let isTicking = false;
    let rafId: number = 0;

    function clamp(v: number, min: number, max: number): number {
      return Math.max(min, Math.min(max, v));
    }

    const onPointerMove = (e: PointerEvent) => {
      tgt.x = e.clientX;
      tgt.y = e.clientY;
      if (shown && !isTicking) {
        startTick();
      }
    };

    rows.forEach((row, i) => {
      row.addEventListener('mouseenter', () => {
        activeHoverIndex = i;
        mat.uniforms.uTex.value = textures[i];
        if (!shown) {
          shown = true;
          sc = 0.85;
          if (canvas) canvas.style.visibility = 'visible';
          startTick();
        }
      });
    });

    const onListLeave = () => {
      shown = false;
    };

    list.addEventListener('mouseleave', onListLeave);
    window.addEventListener('pointermove', onPointerMove, { passive: true });

    function tick() {
      op += ((shown ? 1 : 0) - op) * 0.14;
      sc += (1 - sc) * 0.1;

      if (!shown && op < 0.005) {
        op = 0;
        mat.uniforms.uOp.value = 0;
        if (canvas) canvas.style.visibility = 'hidden';
        isTicking = false;
        return;
      }

      const dx = tgt.x - cur.x;
      const dy = tgt.y - cur.y;
      cur.x += dx * 0.12;
      cur.y += dy * 0.12;

      vel.x += (clamp(dx * 0.02, -1.5, 1.5) - vel.x) * 0.2;
      vel.y += (clamp(-dy * 0.02, -1.5, 1.5) - vel.y) * 0.2;

      mat.uniforms.uVel.value.copy(vel);
      mat.uniforms.uOp.value = op;

      mesh.scale.set(PW * sc, PH * sc, 1);

      // Center horizontally slightly to the right of cursor, clamp to viewport edges
      const targetPosX = Math.min(cur.x + PW * 0.55, W - PW / 2 - 20) - W / 2;
      const targetPosY = -(cur.y - H / 2);
      mesh.position.set(targetPosX, targetPosY, 0);

      // Subtle organic tilt
      mesh.rotation.z = -vel.x * 0.08;

      renderer.render(scene, cam);
      rafId = requestAnimationFrame(tick);
    }

    function startTick() {
      if (isTicking) return;
      isTicking = true;
      rafId = requestAnimationFrame(tick);
    }

    const onResize = () => {
      W = window.innerWidth;
      H = window.innerHeight;
      renderer.setSize(W, H, false);
      cam.left = -W / 2;
      cam.right = W / 2;
      cam.top = H / 2;
      cam.bottom = -H / 2;
      cam.updateProjectionMatrix();

      PW = Math.min(420, W * 0.32);
      PH = Math.round(PW * (896 / 1200));
    };

    window.addEventListener('resize', onResize);

    // ─── Cleanup Handler ──────────────────────────────────────
    cleanupFn = () => {
      window.removeEventListener('pointermove', onPointerMove);
      window.removeEventListener('resize', onResize);
      if (list) list.removeEventListener('mouseleave', onListLeave);
      if (rafId) cancelAnimationFrame(rafId);
      isTicking = false;

      // Dispose three.js resources
      mesh.geometry.dispose();
      mat.dispose();
      textures.forEach((t) => t.dispose());
      renderer.dispose();

      // Clean up canvas from body if moved
      if (canvas && canvas.parentElement === document.body) {
        canvas.remove();
      }
    };
  }

  // Mount on DOM and Astro page transitions
  document.addEventListener('DOMContentLoaded', initServicesHoverBend);
  document.addEventListener('astro:page-load', initServicesHoverBend);
  document.addEventListener('astro:before-swap', () => {
    if (cleanupFn) {
      cleanupFn();
      cleanupFn = null;
    }
  });
</script>
