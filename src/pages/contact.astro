---
/**
 * Contact Page — Sadia Aqeel Portfolio
 * Frosted Glassmorphism Design System with Slow Animated Aurora Backdrop,
 * Specular Highlight & Inner Spotlight tracking cursor,
 * Glass Service Chips, Segmented Sliding Budget Control, Inset Focus Glow Inputs,
 * Sheen Send Button, Copy Email with 2s Confirmation, Live Pulsing Availability Pill,
 * and Magnetic Social Links.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { socialLinks } from '../data/portfolio';
import '../styles/hero.css';
import '../styles/contact.css';
---

<BaseLayout 
  title="Contact Sadia Aqeel — Hire a Professional Graphic Designer" 
  description="Hire Sadia Aqeel for bold brand identity systems, high-converting social media graphic design, business posters, packaging, book covers, and UI/UX design. Available worldwide for projects and retainer contracts."
>
  <div class="contact-page-wrapper">
    
    <!-- ─── IDEA 1: Slow Animated Aurora Backdrop ───────────────── -->
    <div class="aurora" id="contact-aurora" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </div>

    <!-- ─── Header Navigation Row ────────────────────────────── -->
    <header class="contact-header">
      <a href="/" class="contact-logo" aria-label="Sadia Aqeel — Home">
        Sadia<span class="contact-logo__sub">Aqeel</span>
      </a>

      <div class="contact-meta">
        <div class="contact-meta__badge">
          <span class="contact-meta__dot"></span>
          <span>Open for Q3/Q4 Projects</span>
        </div>
        <div class="contact-meta__badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="color:var(--moss);">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
          <span>Response &lt; 24h</span>
        </div>
      </div>
    </header>

    <!-- ─── Hero Section ─────────────────────────────────────── -->
    <section class="contact-hero-sec" id="contact-hero-sec">
      <div class="contact-hero-content" id="contact-hero-content">
        <div class="contact-tag">Get in Touch</div>
        
        <h1 class="contact-title" id="contact-hero-title">
          Let's build something<br>
          <span class="contact-title__italic">unforgettable</span> together.
        </h1>
        
        <p class="contact-subtitle" id="contact-hero-sub">
          Have a project in mind, a brand to launch, or a visual challenge to solve? Select your service scope below to send an instant brief, or reach out directly.
        </p>

        <div class="contact-scroll-cue" id="contact-scroll-cue">
          <span>Scroll to explore brief</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
        </div>
      </div>
    </section>

    <!-- ─── Main Content Grid Container ──────────────────────── -->
    <div class="contact-container" id="contact-main-sec">
      <div class="contact-main-grid">
        
        <!-- Left: Interactive Project Brief Form in Frosted Glass Card -->
        <div class="contact-form-card glass" data-animate="fade-up">
          <form id="interactive-contact-form">
            
            <!-- Step 1: Services (Glass Pills that Fill Forest Green with Checkmark) -->
            <div class="form-step">
              <h2 class="form-section-title">
                <span class="form-section-num step">1</span>
                What services do you need?
              </h2>
              <p class="form-section-desc sub">Select all design disciplines that apply to your vision.</p>
              
              <div class="chips-grid" id="services-chips">
                
                <!-- Brand Identity -->
                <button type="button" class="chip-btn" aria-pressed="false" data-service="Brand Identity">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/>
                    <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/>
                    <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/>
                    <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/>
                    <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.92 0 1.7-.71 1.7-1.63 0-.42-.16-.83-.44-1.14-.28-.31-.44-.72-.44-1.17 0-.92.78-1.66 1.7-1.66h2.48c3.04 0 5.5-2.46 5.5-5.5 0-5.5-4.5-10-10.5-10z"/>
                  </svg>
                  <span>Brand Identity & Strategy</span>
                </button>

                <!-- Packaging Design -->
                <button type="button" class="chip-btn" aria-pressed="false" data-service="Packaging Design">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                    <line x1="12" y1="22.08" x2="12" y2="12"/>
                  </svg>
                  <span>Packaging & Print</span>
                </button>

                <!-- Digital & Web -->
                <button type="button" class="chip-btn" aria-pressed="false" data-service="Digital Experience">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                    <line x1="8" y1="21" x2="16" y2="21"/>
                    <line x1="12" y1="17" x2="12" y2="21"/>
                  </svg>
                  <span>Digital & Web Design</span>
                </button>

                <!-- Custom Illustration -->
                <button type="button" class="chip-btn" aria-pressed="false" data-service="Custom Illustration">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 19l7-7 3 3-7 7-3-3z"/>
                    <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>
                    <circle cx="11" cy="11" r="2"/>
                  </svg>
                  <span>Custom Illustration</span>
                </button>

                <!-- Motion Graphics -->
                <button type="button" class="chip-btn" aria-pressed="false" data-service="Motion & Assets">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="23 7 16 12 23 17 23 7"/>
                    <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                  </svg>
                  <span>Motion Graphics</span>
                </button>

                <!-- Complete Rebrand -->
                <button type="button" class="chip-btn" aria-pressed="false" data-service="Full Rebrand">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.71.79-1.81.19-2.5-.59-.69-1.69-.77-2.39-.08z"/>
                    <path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>
                    <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/>
                    <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>
                  </svg>
                  <span>Complete Rebrand</span>
                </button>

              </div>
              <input type="hidden" name="selected_services" id="input-services" value="" />
            </div>

            <!-- Step 2: Budget Range (Segmented Glass Track with Sliding Thumb) -->
            <div class="form-step">
              <h2 class="form-section-title">
                <span class="form-section-num step">2</span>
                Expected Budget Range
              </h2>
              <p class="form-section-desc sub">Helps tailor the proposal scope to your available resources.</p>

              <div class="seg" id="seg" role="radiogroup" aria-label="Expected Budget Range">
                <span class="thumb" id="thumb"></span>
                <button type="button" role="radio" aria-checked="true" data-budget="$2,000 – $5,000">$2k – $5k</button>
                <button type="button" role="radio" aria-checked="false" data-budget="$5,000 – $10,000">$5k – $10k</button>
                <button type="button" role="radio" aria-checked="false" data-budget="$10,000 – $20,000+">$10k – $20k+</button>
                <button type="button" role="radio" aria-checked="false" data-budget="Flexible / To Be Discussed">Flexible</button>
              </div>
              <input type="hidden" name="selected_budget" id="input-budget" value="$2,000 – $5,000" />
            </div>

            <!-- Step 3: Client Details & Inset Glowing Inputs -->
            <div class="form-step">
              <h2 class="form-section-title">
                <span class="form-section-num step">3</span>
                Project Details & Contact Info
              </h2>
              <p class="form-section-desc sub">A few lines is plenty to kick off our conversation.</p>

              <div class="field-row fields">
                <div class="input-group">
                  <label for="contact-name" class="input-label">Your Name *</label>
                  <input type="text" id="contact-name" name="name" class="custom-input" placeholder="e.g. Sarah Jenkins" required />
                </div>
                <div class="input-group">
                  <label for="contact-email" class="input-label">Email Address *</label>
                  <input type="email" id="contact-email" name="email" class="custom-input" placeholder="sarah@yourbrand.com" required />
                </div>
              </div>

              <div class="input-group full">
                <label for="contact-company" class="input-label">
                  Company / Brand Name <span class="input-label__optional">(Optional)</span>
                </label>
                <input type="text" id="contact-company" name="company" class="custom-input" placeholder="e.g. Vanguard Studio" />
              </div>

              <div class="input-group full">
                <label for="contact-message" class="input-label">Project Vision & Goals *</label>
                <textarea 
                  id="contact-message" 
                  name="message" 
                  class="custom-textarea" 
                  placeholder="Tell me about your brand, target timeline, key goals, or any reference inspirations..." 
                  rows="4" 
                  required
                ></textarea>
              </div>
            </div>

            <!-- Submit CTA Button with Diagonal Sheen on Hover -->
            <button type="submit" class="submit-btn send magnetic" id="submit-brief-btn">
              <span>Send Project Brief</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>

          </form>

          <!-- Success State -->
          <div class="form-success-state" id="form-success-message">
            <div class="success-icon-wrapper">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </div>
            <h3 style="font-family: var(--serif); font-size: 1.6rem; color: var(--forest); margin-bottom: 0.5rem;">
              Brief Received!
            </h3>
            <p style="font-family: var(--sans); color: rgba(43, 74, 31, 0.8); line-height: 1.6; max-width: 420px; margin: 0 auto 1.5rem;">
              Thank you for reaching out. I'll review your project scope and respond within 24 hours with next steps and initial consultation details.
            </p>
            <button type="button" class="chip-btn chip active" id="reset-form-btn">
              Send Another Message
            </button>
          </div>
        </div>

        <!-- Right: Direct Contact & Location Info Sidebar -->
        <aside class="contact-sidebar stack" data-animate="fade-up" data-delay="0.2">
          
          <!-- Copy Email Card (Morphing 2s Feedback) -->
          <div class="sidebar-card glass">
            <h2 class="card-heading">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--moss);">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>Direct Email</span>
            </h2>
            <p class="card-text">Prefer sending an email directly? Copy my address below:</p>

            <div class="email-copy-box mail">
              <span class="email-address">sadiaa.creativestudio@gmail.com</span>
              <button type="button" class="copy-btn copy" id="copy-email-trigger">
                Copy Email
              </button>
            </div>
          </div>

          <!-- Location & Availability Card with Pulsing Dot & Live UTC Clock -->
          <div class="sidebar-card glass">
            <h2 class="card-heading">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--moss);">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>Location & Availability</span>
            </h2>
            <p class="card-text">Working with clients worldwide across North America, Europe, and Asia.</p>

            <div class="time-widget row">
              <span class="location-info">Available Worldwide (Remote)</span>
              <span class="live">
                <b></b>
                <span id="local-clock">--:--:-- UTC</span>
              </span>
            </div>
          </div>

          <!-- Social Networks Card with Magnetic Lean -->
          <div class="sidebar-card glass">
            <h2 class="card-heading">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--moss);">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
              <span>Connect & Socials</span>
            </h2>
            <p class="card-text">Explore ongoing design work, process shots, and design thoughts:</p>

            <div class="socials-flex soc">
              {socialLinks.map((link) => (
                <a 
                  href={link.url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="social-pill"
                >
                  <span>{link.platform}</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </a>
              ))}
            </div>
          </div>

        </aside>

      </div>
    </div>

    <!-- ─── FAQ Accordion Section ────────────────────────────── -->
    <section class="faq-section" data-animate="fade-up">
      <div class="faq-header">
        <h2 class="faq-title">Frequently Asked Questions</h2>
        <p class="card-text" style="font-size: 1.05rem; margin-top: 0.5rem; text-align: center;">
          Everything you need to know about starting a project.
        </p>
      </div>

      <div class="faq-grid">
        <!-- FAQ 1 -->
        <div class="faq-item glass">
          <button type="button" class="faq-question" aria-expanded="false">
            <span>What is your typical project timeline?</span>
            <span class="faq-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </button>
          <div class="faq-answer">
            <p class="faq-answer-text">
              Brand identity projects typically take 3 to 5 weeks. Packaging and full digital experience designs average 4 to 8 weeks depending on scope, revisions, and complexity.
            </p>
          </div>
        </div>

        <!-- FAQ 2 -->
        <div class="faq-item glass">
          <button type="button" class="faq-question" aria-expanded="false">
            <span>How does the payment and deposit process work?</span>
            <span class="faq-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </button>
          <div class="faq-answer">
            <p class="faq-answer-text">
              Projects operate on a 50/50 payment split: a 50% initial deposit reserves your timeline slot, and the remaining 50% is due upon final approved handoff before file delivery.
            </p>
          </div>
        </div>

        <!-- FAQ 3 -->
        <div class="faq-item glass">
          <button type="button" class="faq-question" aria-expanded="false">
            <span>What file formats will I receive upon completion?</span>
            <span class="faq-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </button>
          <div class="faq-answer">
            <p class="faq-answer-text">
              You will receive a complete design asset bundle including vector source files (.AI, .EPS, .SVG), high-res print PDFs, web-optimized kits (.PNG, .WebP), brand guideline books, and color/typography rules.
            </p>
          </div>
        </div>

        <!-- FAQ 4 -->
        <div class="faq-item glass">
          <button type="button" class="faq-question" aria-expanded="false">
            <span>Do you offer monthly design retainers?</span>
            <span class="faq-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </button>
          <div class="faq-answer">
            <p class="faq-answer-text">
              Yes! For established brands needing ongoing visual design, social assets, and marketing collateral support, monthly retainer options are available.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Toast Notification Element -->
    <div class="contact-toast" id="copy-toast">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M20 6L9 17l-5-5"></path>
      </svg>
      <span>Email copied to clipboard!</span>
    </div>

  </div>

  <Footer />
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  document.addEventListener('DOMContentLoaded', () => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ─── 1. Aurora Animation Tab Pause (Performance Constraint) ──
    const aurora = document.getElementById('contact-aurora');
    document.addEventListener('visibilitychange', () => {
      if (!aurora) return;
      if (document.hidden) {
        aurora.classList.add('aurora--paused');
      } else {
        aurora.classList.remove('aurora--paused');
      }
    });

    // ─── 2. Frosted Glass Cards Pointer Spotlight & Specular Edge ─
    // Single throttled listener per card using requestAnimationFrame
    const glassCards = document.querySelectorAll<HTMLElement>('.glass');
    glassCards.forEach(card => {
      let rafId: number | null = null;
      card.addEventListener('pointermove', (e) => {
        if (rafId !== null) return;
        rafId = requestAnimationFrame(() => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
          rafId = null;
        });
      });
      card.addEventListener('pointerleave', () => {
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
      });
    });

    // ─── 3. Multi-Select Service Chips ─────────────────────────────
    const serviceChips = document.querySelectorAll<HTMLButtonElement>('#services-chips .chip-btn');
    const hiddenServicesInput = document.getElementById('input-services') as HTMLInputElement | null;
    const selectedServices = new Set<string>();

    serviceChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const val = chip.getAttribute('data-service');
        if (!val) return;

        const isPressed = chip.getAttribute('aria-pressed') === 'true';
        if (isPressed) {
          selectedServices.delete(val);
          chip.setAttribute('aria-pressed', 'false');
          chip.classList.remove('active');
        } else {
          selectedServices.add(val);
          chip.setAttribute('aria-pressed', 'true');
          chip.classList.add('active');
        }

        if (hiddenServicesInput) {
          hiddenServicesInput.value = Array.from(selectedServices).join(', ');
        }
      });
    });

    // ─── 4. Segmented Glass Budget Control with Sliding Thumb ─────
    const budgetBtns = document.querySelectorAll<HTMLButtonElement>('#seg button');
    const thumb = document.getElementById('thumb');
    const hiddenBudgetInput = document.getElementById('input-budget') as HTMLInputElement | null;

    budgetBtns.forEach((btn, index) => {
      btn.addEventListener('click', () => {
        budgetBtns.forEach(b => b.setAttribute('aria-checked', 'false'));
        btn.setAttribute('aria-checked', 'true');

        if (thumb) {
          thumb.style.transform = `translateX(${index * 100}%)`;
        }

        const val = btn.getAttribute('data-budget');
        if (hiddenBudgetInput && val) {
          hiddenBudgetInput.value = val;
        }
      });
    });

    // ─── 5. Direct Email One-Click Copy & Morphing Feedback ────────
    const copyTrigger = document.getElementById('copy-email-trigger');
    const toast = document.getElementById('copy-toast');
    let copyTimeout: number | null = null;

    if (copyTrigger) {
      copyTrigger.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('sadiaa.creativestudio@gmail.com');
        } catch (_) {
          // Clipboard fallback
        }

        copyTrigger.textContent = 'Copied';
        copyTrigger.classList.add('done');

        if (toast) {
          toast.classList.add('show');
        }

        if (copyTimeout) clearTimeout(copyTimeout);
        copyTimeout = window.setTimeout(() => {
          copyTrigger.textContent = 'Copy Email';
          copyTrigger.classList.remove('done');
          if (toast) {
            toast.classList.remove('show');
          }
        }, 2000);
      });
    }

    // ─── 6. Live UTC Studio Clock (Every Second) ───────────────────
    const clockEl = document.getElementById('local-clock');
    const updateClock = () => {
      if (!clockEl) return;
      clockEl.textContent = new Date().toISOString().slice(11, 19) + ' UTC';
    };
    updateClock();
    setInterval(updateClock, 1000);

    // ─── 7. Magnetic Social Links (Lean Toward Cursor) ─────────────
    if (!prefersReduced) {
      const socialLinksElements = document.querySelectorAll<HTMLElement>('.soc .social-pill');
      socialLinksElements.forEach(a => {
        let rafId: number | null = null;
        a.addEventListener('pointermove', (e) => {
          if (rafId !== null) return;
          rafId = requestAnimationFrame(() => {
            const r = a.getBoundingClientRect();
            a.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * 0.25}px, ${(e.clientY - r.top - r.height / 2) * 0.35}px)`;
            rafId = null;
          });
        });
        a.addEventListener('pointerleave', () => {
          if (rafId !== null) {
            cancelAnimationFrame(rafId);
            rafId = null;
          }
          a.style.transform = '';
        });
      });
    }

    // ─── 8. Form Submission Simulation & State Toggle ──────────────
    const form = document.getElementById('interactive-contact-form') as HTMLFormElement | null;
    const successBox = document.getElementById('form-success-message');
    const resetBtn = document.getElementById('reset-form-btn');

    if (form && successBox) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const submitBtn = document.getElementById('submit-brief-btn') as HTMLButtonElement | null;
        if (submitBtn) {
          submitBtn.innerHTML = `<span>Sending...</span>`;
          submitBtn.disabled = true;
        }

        setTimeout(() => {
          form.style.display = 'none';
          successBox.classList.add('show');
        }, 800);
      });
    }

    if (resetBtn && form && successBox) {
      resetBtn.addEventListener('click', () => {
        form.reset();
        selectedServices.clear();
        serviceChips.forEach(c => {
          c.setAttribute('aria-pressed', 'false');
          c.classList.remove('active');
        });
        budgetBtns.forEach((b, i) => {
          b.setAttribute('aria-checked', i === 0 ? 'true' : 'false');
        });
        if (thumb) {
          thumb.style.transform = 'translateX(0%)';
        }
        if (hiddenBudgetInput) {
          hiddenBudgetInput.value = '$2,000 – $5,000';
        }
        if (hiddenServicesInput) {
          hiddenServicesInput.value = '';
        }

        const submitBtn = document.getElementById('submit-brief-btn') as HTMLButtonElement | null;
        if (submitBtn) {
          submitBtn.innerHTML = `
            <span>Send Project Brief</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          `;
          submitBtn.disabled = false;
        }

        successBox.classList.remove('show');
        form.style.display = 'block';
      });
    }

    // ─── 9. Interactive FAQ Accordion ──────────────────────────────
    const faqItems = document.querySelectorAll<HTMLElement>('.faq-item');
    faqItems.forEach(item => {
      const questionBtn = item.querySelector('.faq-question');
      questionBtn?.addEventListener('click', () => {
        const isActive = item.classList.contains('active');
        faqItems.forEach(other => other.classList.remove('active'));
        if (!isActive) {
          item.classList.add('active');
        }
      });
    });

    // ─── 10. GSAP Hero Scale Down ──────────────────────────────────
    if (!prefersReduced && typeof gsap !== 'undefined') {
      try {
        gsap.registerPlugin(ScrollTrigger);
        const heroSec = document.getElementById('contact-hero-sec');
        const heroContent = document.getElementById('contact-hero-content');
        const heroCue = document.getElementById('contact-scroll-cue');

        if (heroSec && heroContent) {
          gsap.to(heroContent, {
            scale: 0.78,
            y: -50,
            opacity: 0.9,
            ease: 'none',
            scrollTrigger: {
              trigger: heroSec,
              start: 'top top',
              end: 'bottom top',
              scrub: 0.5,
            }
          });

          if (heroCue) {
            gsap.to(heroCue, {
              opacity: 0,
              y: -20,
              ease: 'none',
              scrollTrigger: {
                trigger: heroSec,
                start: 'top top',
                end: '30% top',
                scrub: true,
              }
            });
          }
        }
      } catch (_) {
        // Fallback gracefully if GSAP not loaded
      }
    }
  });
</script>
